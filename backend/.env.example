# Copy to .env for local development. On Railway, set these in the service's
# Variables tab instead (there is no .env file in production).

# --- Database ---
# Railway provides this. Set it on the backend service as a reference variable:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Leave it unset locally to use SQLite (backend/db.sqlite3).
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Django ---
# Production: DEBUG=false and a long random DJANGO_SECRET_KEY (required when DEBUG=false).
DEBUG=true
DJANGO_SECRET_KEY=dev-secret-change-me

# --- Frontend / CORS ---
# The React app's origin (no trailing slash needed). Added to CORS and CSRF trusted origins.
FRONTEND_URL=http://localhost:5173
# Optional extra CORS origins, comma-separated (e.g. preview deploys).
EXTRA_CORS_ORIGINS=

# --- Superuser (optional) ---
# If both are set, `python manage.py ensure_superuser` creates this admin once (email = username).
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- LLM: set one provider ---
LLM_PROVIDER=anthropic            # or "openai" or "none" (keyword fallback only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Email: console by default ---
# For real Gmail: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend, then check with
#   python manage.py test_email you@example.com      (setup steps: PROGRESS.md, Phase 6)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST_USER=                  # the Gmail address that created the App Password
EMAIL_HOST_PASSWORD=              # Gmail App Password, not the normal password (spaces are fine)

# --- Seed (optional) ---
# Send a seeded mentor's notification emails to a real inbox. Login still uses the demo address.
# SEED_REAL_EMAILS=maya@demo.com=teammate@gmail.com,priya@demo.com=other@gmail.com

{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/venv/Scripts/python.exe",
      "runtimeArgs": ["backend/manage.py", "runserver", "127.0.0.1:8000", "--noreload"],
      "env": { "EMAIL_BACKEND": "django.core.mail.backends.console.EmailBackend", "LLM_PROVIDER": "none" },
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "env": { "BACKEND_URL": "http://127.0.0.1:8000" },
      "port": 3000
    }
  ]
}
